/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

/* 页面标题 */
.header {
  text-align: center;
  padding: 80rpx 0 60rpx;
  color: white;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}

.subtitle {
  display: block;
  font-size: 28rpx;
  opacity: 0.9;
}

/* 车辆列表 */
.vehicle-list {
  padding: 20rpx 0;
}

.vehicle-card {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
  transition: all 0.3s;
  position: relative;
  overflow: hidden;
}

.vehicle-card::before {
  content: '';
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 8rpx;
  background: var(--card-color, #007AFF);
}

.vehicle-card:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.15);
}

/* 车辆颜色标识点 */
.vehicle-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

/* 车辆Logo */
.vehicle-logo {
  width: 80rpx;
  height: 80rpx;
  margin-right: 24rpx;
  border-radius: 16rpx;
  background: #f5f5f5;
  padding: 8rpx;
}

/* 车辆信息 */
.vehicle-info {
  flex: 1;
}

.vehicle-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.vehicle-plate {
  display: block;
  font-size: 28rpx;
  color: #666;
}

/* 选择箭头 */
.arrow-icon {
  font-size: 48rpx;
  color: #999;
  font-weight: 300;
}

/* 底部扫码按钮 */
.footer {
  margin-top: 60rpx;
  padding: 0 20rpx;
}

.scan-btn {
  width: 100%;
  background: white;
  color: #667eea;
  border-radius: 48rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.scan-btn::after {
  border: none;
}

.scan-icon {
  font-size: 36rpx;
}

.scan-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.2);
}
