/* pages/map/map.wxss */

.map-page {
  position: relative;
  width: 100vw;
  height: 100vh;
}

/* 车辆信息卡片 */
.vehicle-info-card {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  z-index: 100;
  display: flex;
  align-items: center;
  background: white;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15);
}

.vehicle-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.2);
}

.car-logo {
  width: 64rpx;
  height: 64rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background: #f5f5f5;
  padding: 6rpx;
}

.car-info {
  flex: 1;
}

.car-name {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.car-plate {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.back-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  color: #999;
}

/* 地图容器 */
.map-container {
  width: 100%;
  height: 100%;
}

#vehicleMap {
  width: 100%;
  height: 100%;
}

/* 位置信息卡片 */
.location-info-card {
  position: absolute;
  bottom: 180rpx;
  left: 20rpx;
  right: 20rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  padding: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.12);
}

.info-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.info-row:last-child {
  margin-bottom: 0;
}

.label {
  width: 40rpx;
  font-size: 28rpx;
  margin-right: 12rpx;
}

.value {
  flex: 1;
  font-size: 26rpx;
  color: #333;
  line-height: 1.4;
}

.location-address {
  font-weight: 500;
}

.warning {
  color: #ff9500;
}

/* 操作按钮 */
.action-buttons {
  position: absolute;
  bottom: 40rpx;
  left: 20rpx;
  right: 20rpx;
  display: flex;
  gap: 16rpx;
}

.action-buttons .btn {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  border: none;
}

.action-buttons .btn::after {
  border: none;
}

.btn-secondary {
  background: rgba(108, 117, 125, 0.9);
  color: white;
}

.btn-primary {
  background: rgba(0, 122, 255, 0.9);
  color: white;
}

.btn[disabled] {
  opacity: 0.6;
}

/* 自定义标记样式 */
.custom-marker {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid white;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.3);
}

.marker-logo {
  width: 40rpx;
  height: 40rpx;
}

.marker-label {
  font-size: 20rpx;
  color: white;
  font-weight: bold;
  margin-top: 4rpx;
}
